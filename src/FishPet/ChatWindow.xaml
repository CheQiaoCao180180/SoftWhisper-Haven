<Window x:Class="FishPet.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="和鲸鲸说说话"
        Width="420" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True">
    <Border CornerRadius="18" Background="#FFFBFCFF" BorderBrush="#FFDBE8F6" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.18" Color="#FF3A5A80"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag">
                <Grid Margin="18,0,10,0">
                    <TextBlock Text="和鲸鲸说说话"
                               VerticalAlignment="Center"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="#FF344458"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Width="30" Height="28" Click="OnClear"
                                ToolTip="清空对话（她会忘掉之前聊的）"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#FF7C8FA5" FontSize="14" Cursor="Hand"/>
                        <Button Content="✕" Width="30" Height="28" Click="OnClose"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#FF7C8FA5" FontSize="13" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 消息区 -->
            <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Margin="14,0,14,6" Padding="0,0,6,0">
                <StackPanel x:Name="Messages"/>
            </ScrollViewer>

            <!-- 输入区 -->
            <Border Grid.Row="2" Background="#FFF4F9FF" CornerRadius="0,0,18,18" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="12" Background="White"
                            BorderBrush="#FFDBE8F6" BorderThickness="1" Padding="12,8">
                        <TextBox x:Name="Input"
                                 BorderThickness="0" Background="Transparent"
                                 FontSize="14" Foreground="#FF344458"
                                 VerticalContentAlignment="Center"
                                 TextWrapping="Wrap"
                                 MaxHeight="90"
                                 KeyDown="OnInputKey"
                                 TextChanged="OnInputChanged"/>
                    </Border>

                    <Button x:Name="Send" Grid.Column="1" Content="发"
                            Width="52" Height="38" Margin="10,0,0,0"
                            Click="OnSend"
                            Background="#FFFFAFCA" BorderThickness="0"
                            Foreground="White" FontSize="14" FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
